{
  "version": 1,
  "timezone": "Asia/Shanghai",
  "daily_store": "LifeState/days/YYYY-MM-DD.json",
  "purpose": "Compact longitudinal state for food, sleep, movement, training, and exploratory reflection. ChatGPT is the analysis and narrative interface; no dashboard required.",
  "daily_fields": {
    "date": "YYYY-MM-DD",
    "sleep": {
      "periods": [
        {
          "start": "HH:MM or ISO datetime",
          "end": "HH:MM or ISO datetime",
          "duration_minutes": "number|null",
          "kind": "main|nap|other",
          "subjective_quality": "optional free text"
        }
      ],
      "total_minutes": "number|null",
      "notes": "optional free text"
    },
    "food": [
      {
        "time": "HH:MM or approximate period",
        "meal": "breakfast|lunch|dinner|snack|other",
        "items": ["free-text food item"],
        "amounts": ["optional free-text amount"],
        "notes": "optional free text"
      }
    ],
    "exercise": [
      {
        "time": "HH:MM or approximate period",
        "type": "run|walk|posture|mobility|strength|baduanjin|crawl|other",
        "duration_minutes": "number|null",
        "distance_km": "number|null",
        "details": "free text",
        "effort": "optional free text",
        "body_feedback": "optional free text"
      }
    ],
    "body_state": {
      "weight_kg": "number|null",
      "waist_cm": "number|null",
      "energy": "optional free text",
      "hunger": "optional free text",
      "soreness_or_pain": "optional free text",
      "posture_or_movement_observations": "optional free text"
    },
    "context": {
      "learning_load": "optional free text",
      "stress_or_interruptions": "optional free text",
      "other": "optional free text"
    },
    "assistant_analysis": {
      "observed_patterns": ["evidence-grounded observations only"],
      "uncertainties": ["what cannot yet be concluded"],
      "exploratory_questions": ["questions chosen to test plausible explanations or reveal missing variables"],
      "next_observations": ["small things worth noticing next time; not mandatory tasks"]
    }
  },
  "rules": {
    "preserve_user_wording_when_it_contains_signal": true,
    "do_not_invent_missing_quantities": true,
    "use_null_or_omit_when_unknown": true,
    "separate_observation_from_inference": true,
    "avoid_health_scores_and_dashboard_gamification": true,
    "questions_should_be_exploratory_not_checklist_like": true,
    "analysis_should_compare_across_days_only_when_enough_data_exists": true,
    "user_can_correct_any_record_and_the_file_should_be_updated": true
  }
}
